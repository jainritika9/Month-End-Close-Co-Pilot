@EndUserText.label: 'MWC R2R - Close checklist (auth)'
@MappingRole: true
// Row-level check on company code: users see only company codes they may display
// FI documents for (auth object F_BKPF_BUK, activity 03), same as FB03 / FBL3N.
// Company code now comes from the inspection lot's maintenance order (AUFK-BUKRS): a lot with no
// order, or whose order carries no company code, has a blank CompanyCode and this check excludes
// it for everyone - see the "does NOT carry over" note in zi_r2r_closetask.ddls.asddls.
define role ZI_R2R_CloseTask {
  grant select on ZI_R2R_CloseTask
    where ( CompanyCode ) = aspect pfcg_auth( F_BKPF_BUK, BUKRS, ACTVT = '03' );
}
